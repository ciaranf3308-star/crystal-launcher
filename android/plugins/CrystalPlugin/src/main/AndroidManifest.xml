<?xml version="1.0" encoding="utf-8"?>
<!-- CrystalPlugin library manifest.
     The namespace is declared in build.gradle; this file exists because
     the Android Gradle Plugin requires a manifest for library modules.

     The <meta-data> entry is how the Godot engine discovers Android
     plugins at runtime: on startup it scans the merged app manifest for
     org.godotengine.plugin.v1.* entries and instantiates each listed
     GodotPlugin class. Without this entry the plugin's classes are still
     merged into the APK (so the .gdap/AAR wiring looks fine) but
     Engine.get_singleton("CrystalPlugin") never resolves — the exact
     silent failure seen on beta1–beta3 (bridge: no_plugin). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <meta-data
            android:name="org.godotengine.plugin.v1.CrystalPlugin"
            android:value="io.crystalnova.launcher.plugin.CrystalPlugin" />
    </application>
</manifest>
